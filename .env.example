# cp .env.example .env  (절대 커밋하지 마세요. .gitignore 에 포함됨)

# 키움 REST API (openapi.kiwoom.com 에서 앱키 발급, 실행할 PC의 IP 등록)
KIWOOM_APPKEY=
KIWOOM_SECRETKEY=

# 토스증권 Open API (토스증권 WTS > 설정 > Open API)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# TypeSafe (Jev)
TYPESAFE_API_KEY=

# mode = "live" 로 실제 주문을 내려면 아래 값을 정확히 입력
# AUTOTRADER_LIVE_CONFIRM=yes-i-accept-the-risk
